# Test env vars for apps/web Vitest suites (Phase 0 Step 17 RLS suite + future
# integration tests). Copy to .env.test.local (gitignored) and populate.
# In CI the same names come from GitHub Actions secrets.
#
# IMPORTANT: point at the arcadia-TEST Supabase project, never production.
# The suite creates and deletes users + realms; running against production
# would corrupt live data. helpers.ts blocks known production project refs.

TEST_SUPABASE_URL=https://idxgcrwikmcuqrrxbogj.supabase.co   # arcadia-test
TEST_SUPABASE_ANON_KEY=<anon key from arcadia-test project settings>
TEST_SUPABASE_SERVICE_KEY=<service_role key from arcadia-test project settings>

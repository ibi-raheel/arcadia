# Supabase — arcadia (production) project ref: eqbzltiasmuckgsapkye
NEXT_PUBLIC_SUPABASE_URL=https://eqbzltiasmuckgsapkye.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>       # Supabase dashboard → API → Project API keys
SUPABASE_SERVICE_KEY=<service-role-key>         # server only — never expose to the browser
SUPABASE_JWT_SECRET=<jwt-secret>                # server only — Supabase dashboard → API → JWT Settings

# Colyseus (game server)
NEXT_PUBLIC_COLYSEUS_URL=ws://localhost:2567

# Cloudflare Stream — enabled in Phase 3 (Week 9); commented until then
# CF_ACCOUNT_ID=<cloudflare-account-id>
# CF_STREAM_TOKEN=<cloudflare-api-token>
# CF_STREAM_WEBHOOK_SECRET=<webhook-signing-secret>

# The scribe (Phase 10 — AI course maker) uses Google's Gemini API
# directly — text via gemini-2.5-pro / flash, images via
# gemini-2.5-flash-image-preview. One key covers everything. Get one
# from https://aistudio.google.com/apikey. See ADR 0013.
# Without this key, /dashboard/courses/conjure stages return a typed
# "the scribe is not configured on this deploy" error.
GOOGLE_GENERATIVE_AI_API_KEY=<gemini-api-key>
# Soft per-draft output-token cap. Hard stop enforced server-side.
SCRIBE_TOKEN_BUDGET_PER_DRAFT=75000

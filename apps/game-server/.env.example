PORT=2567
HOST=0.0.0.0

# Redis presence/driver is opt-in. Only set USE_REDIS=true when running more
# than one Colyseus replica — MVP is single-replica (PRD §5, 20 CCU), so
# in-memory presence is correct and faster to boot.
USE_REDIS=false
REDIS_URL=redis://localhost:6379    # only read when USE_REDIS=true

# Supabase — used by Colyseus onAuth in Phase 2
NEXT_PUBLIC_SUPABASE_URL=https://eqbzltiasmuckgsapkye.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>    # Supabase dashboard → API → service_role

# Dev helper — exposes /colyseus dashboard when 'true'
COLYSEUS_MONITOR=false

{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npm run build --workspace=@arcadia/game-server"
  },
  "deploy": {
    "startCommand": "npm run start --workspace=@arcadia/game-server",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 15,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
